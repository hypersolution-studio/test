  "exemplo_implementacao_api": {
    "linguagem": "Node.js + Express",
    "codigo": "// Exemplo de endpoint em Node.js\nconst express = require('express');\nconst app = express();\n\napp.get('/buscar', async (req, res) => {\n  const {\n    tipo_negocio,\n    faixa_preco,\n    dormitorios,\n    tipo_imovel,\n    tipo_sala,\n    vagas,\n    localizacao\n  } = req.query;\n\n  // Buscar no banco de dados\n  const imoveis = await db.imoveis.find({\n    tipo_negocio: tipo_negocio,\n    preco: getPrecoPorFaixa(faixa_preco),\n    dormitorios: parseInt(dormitorios),\n    tipo: tipo_imovel,\n    sala: tipo_sala !== 'tanto_faz' ? tipo_sala : undefined,\n    vagas: parseInt(vagas),\n    endereco: { $regex: localizacao, $options: 'i' }\n  });\n\n  res.json({\n    imoveis: imoveis,\n    total_encontrados: imoveis.length,\n    filtros_aplicados: req.query,\n    mensagem: `Encontramos ${imoveis.length} imóveis`\n  });\n});\n\nfunction getPrecoPorFaixa(faixa) {\n  const faixas = {\n    'ate_500k': { $lte: 500000 },\n    '500k_1m': { $gte: 500000, $lte: 1000000 },\n    '1m_2m': { $gte: 1000000, $lte: 2000000 },\n    'acima_2m': { $gte: 2000000 },\n    'ate_1500': { $lte: 1500 },\n    '1500_3000': { $gte: 1500, $lte: 3000 },\n    '3000_5000': { $gte: 3000, $lte: 5000 },\n    'acima_5000': { $gte: 5000 }\n  };\n  return faixas[faixa] || {};\n}\n\napp.listen(3000);"
  },
